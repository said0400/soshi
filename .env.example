# ══════════════════════════════════════════════════════════════════════
# .env.example — للتشغيل المحلي فقط: cp .env.example .env
# ⚠️ المستودع عام: لا تضع أي سرّ في الملفات.
#    على GitHub:  Settings → Secrets and variables → Actions
#    GITHUB_TOKEN وGITHUB_REPOSITORY يوفرهما GitHub Actions تلقائياً.
# ══════════════════════════════════════════════════════════════════════

# ─────────────── GitHub Secrets ───────────────

# مفاتيح متعددة في سرّ واحد مفصولة بفاصلة (للتدوير):  key1,key2,key3
GEMINI_API_KEY=
GROQ_API_KEY=              # احتياطي عند فشل كل مفاتيح Gemini
PEXELS_API_KEY=
PIXABAY_API_KEY=           # اختياري

# رابط Web App الخاص بـ Apps Script (ينتهي بـ /exec) + السرّ المشترك
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# ─────────────── للتشغيل المحلي فقط (في Actions تلقائية) ───────────────
# GITHUB_TOKEN=            # Personal access token بصلاحية contents:write
# GITHUB_REPOSITORY=owner/repo

# ─────────────── Google Apps Script → Script Properties ───────────────
# (لا توضع في GitHub إطلاقاً)
#   APPS_SCRIPT_SECRET   نفس قيمة السرّ أعلاه
#   MAKE_WEBHOOK_URL     رابط Custom webhook لسيناريو Make الواحد
#   MAKE_AUTH_TOKEN      (اختياري) يُرسل في الحقل auth ليفلتره Make

# اختياري
# AI_OPERATION_SLEEP=1.0
