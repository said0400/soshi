# ══════════════════════════════════════════════════════════════════════
# .env.example — للتشغيل المحلي فقط: cp .env.example .env
# ⚠️ المستودع عام: لا تضع أي سرّ في الملفات.
#    على GitHub:  Settings → Secrets and variables → Actions
#    على Cloudflare:  npx wrangler secret put <NAME>   (من مجلد worker/)
# ══════════════════════════════════════════════════════════════════════

# ─────────────── GitHub Secrets (الإنتاج) ───────────────

# مفاتيح متعددة في سرّ واحد مفصولة بفاصلة (للتدوير):  key1,key2,key3
GEMINI_API_KEY=
GROQ_API_KEY=              # احتياطي عند فشل كل مفاتيح Gemini
PEXELS_API_KEY=
PIXABAY_API_KEY=           # اختياري

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# رابط عام للـ bucket (r2.dev أو نطاق خاص). إن تُرك فارغاً تُستعمل روابط موقّعة (3 أيام)
R2_PUBLIC_BASE_URL=

# اختياري
# AI_OPERATION_SLEEP=1.0

# ─────────────── Cloudflare Worker Secrets (النشر) ───────────────
# لا توضع في GitHub إطلاقاً:
#   MAKE_WEBHOOK_URL_AR / MAKE_WEBHOOK_URL_FR / MAKE_WEBHOOK_URL_EN / MAKE_WEBHOOK_URL_ES
#   MAKE_AUTH_TOKEN   (اختياري، يُرسل في الحقل auth ليفلتره Make)
